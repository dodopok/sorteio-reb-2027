# Railway: referência a Postgres.DATABASE_URL (rede privada criptografada).
# Fora da rede privada, use conexão com SSL.
NUXT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
NUXT_ADMIN_EMAIL=dev@dodopok.dev
# Gere a senha/hash e o segredo localmente com npm run admin:setup
NUXT_ADMIN_PASSWORD_HASH=
NUXT_IP_HASH_SECRET=
# Turnstile: obrigatório em produção, validado também no servidor.
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_PUBLIC_SITE_URL=https://sorteio.redeepiscopalbrasileira.com.br
NUXT_PUBLIC_ORGANIZER_NAME=Rede Episcopal Brasileira
NUXT_PUBLIC_ORGANIZER_CNPJ=
NUXT_PUBLIC_PRIVACY_EMAIL=dev@dodopok.dev
